rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Property Images:
    // - Publicly readable for website image rendering
    // - Uploadable/deletable ONLY by authenticated administrators
    // - Strict image content type and max size validation (10MB)
    match /properties/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default deny for all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
